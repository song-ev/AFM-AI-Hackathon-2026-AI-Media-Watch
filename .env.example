# Local development only. Never commit .env or real credentials.
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
POSTGRES_DB=aimw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aimw
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
DJANGO_LOG_LEVEL=INFO

# Configure one provider. No real API keys in this template.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=120
LLM_FORCE_JSON=False
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
WHISPER_STAGE1_MODEL=tiny
WHISPER_STAGE2_MODEL=base
TESSERACT_CMD=tesseract
TESSDATA_DIR=
OCR_MIN_WORD_CONFIDENCE=40
YOLO_MODEL_PATH=yolov8n.pt
YOLO_LOGO_CLASSES=
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.5
SCENEDETECT_THRESHOLD=27
RISK_SCORE_VERDICT_THRESHOLD=60
IDENTITY_VOICE_THRESHOLD=0.75
IDENTITY_FACE_THRESHOLD=0.6

# Container paths require an explicit read-only mount; keep cookies outside Git.
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
YTDLP_IMPERSONATE=chrome
YTDLP_JS_RUNTIMES=deno,node

# Optional map provider for Docker frontend; these are public browser values.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
